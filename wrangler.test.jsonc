{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hoangdz-store-api-test",
  "main": "workers/worker.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hoangdzstore-test",
      "database_id": "00000000-0000-4000-8000-000000000001"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ANALYTICS_BUCKET",
      "bucket_name": "hoangdz-store-test"
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://hoangdzstore.pages.dev,http://localhost:5500,http://127.0.0.1:5500",
    "ANALYTICS_MODE": "local"
  }
}
